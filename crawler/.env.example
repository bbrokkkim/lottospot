# -------------------------------------------------------
# LottoSpot Crawler 환경변수 예시
# 이 파일을 .env로 복사한 뒤 실제 값을 채워 넣으세요.
# cp .env.example .env
# -------------------------------------------------------

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lottospot
DB_USER=root
DB_PASS=12341234

# 카카오 로컬 API (주소->좌표 변환)
KAKAO_API_KEY=your_kakao_rest_api_key_here

# Redis (캐시 무효화용, 선택)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
